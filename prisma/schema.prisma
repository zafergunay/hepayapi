// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Service {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  summary   String   @db.Text
  body      String   @db.Text
  icon      String   @default("shield")
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum Region {
  MARAS
  HATAY
  ADIYAMAN
}

model Project {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  region    Region
  summary   String   @db.Text
  body      String   @db.Text
  coverImage String
  gallery   String   @default("[]")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String    @db.Text
  body        String    @db.Text
  coverImage  String
  published   Boolean   @default(false)
  publishedAt DateTime?
  seoTitle       String?
  seoDescription String? @db.Text
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SiteSettings {
  id             String  @id @default("default")
  heroTitle      String
  heroSubtitle   String   @db.Text
  phone          String
  email          String
  address        String
  seoTitle       String
  seoDescription String   @db.Text
  updatedAt      DateTime @updatedAt
}
