# Copy to .env for local development. In production these are set in the
# Vercel project settings (Settings > Environment Variables) — see README.

# cPanel MySQL/MariaDB. The host must be reachable from outside the hosting
# account (cPanel > Remote MySQL). Keep connectionLimit low: every serverless
# instance opens its own pool and shared hosting caps concurrent connections.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE?connectionLimit=2&idleTimeout=60"

# Signs the admin session cookie. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="generate-a-long-random-value"

# Absolute site origin, used by sitemap.xml, robots.txt and canonical URLs.
# Production: https://www.hepayapi.com.tr — the www host is the one bound to the
# deployment; the apex only issues a 308 to it, so pointing this at the apex
# would advertise a redirect as the canonical URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Set automatically by the Vercel Blob integration. When present, admin image
# uploads go to Blob storage; when absent they are written to public/uploads,
# which is the local-development path.
# BLOB_READ_WRITE_TOKEN=""
